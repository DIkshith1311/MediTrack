# Copy to .env. Replace every CHANGE_ME value before starting Docker.
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_DATABASE=meditrack
MYSQL_USER=meditrack
# Encode special characters in the username/password when forming this URL.
DATABASE_URL=mysql://meditrack:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:3307/meditrack
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=CHANGE_ME_VECTOR_KEY
EMBEDDING_URL=http://127.0.0.1:8000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
DEMO_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DEMO_STAFF_PASSWORD=CHANGE_ME_STAFF_PASSWORD

# Generated automatically by scripts/apply-update.ts. Do not copy placeholder passwords.
# MYSQL_AUTH_PASSWORD, MYSQL_ADMIN_PASSWORD, MYSQL_STAFF_PASSWORD
# AUTH_DATABASE_URL, ADMIN_DATABASE_URL, STAFF_DATABASE_URL
MYSQL_HOST_PORT=3307
