{
  "name": "meditrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit.test.ts tests/database-role.test.ts",
    "test:integration": "tsx --test tests/integration.test.ts",
    "seed": "tsx scripts/seed.ts",
    "reindex": "tsx scripts/reindex.ts",
    "screenshots": "node --env-file=.env --import tsx scripts/capture-screenshots.ts",
    "test:rbac": "node --env-file=.env --import tsx --test tests/rbac.integration.test.ts",
    "test:vector": "node --env-file=.env --import tsx scripts/verify-vector.ts",
    "update:rubric": "node --env-file=.env --import tsx scripts/apply-update.ts"
  },
  "dependencies": {
    "mysql2": "3.24.5",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
